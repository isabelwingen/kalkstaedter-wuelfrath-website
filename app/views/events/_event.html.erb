<article class="card">
  <% if event.image.attached? %>
    <div class="card-image card-image--poster">
      <%= image_tag event.image, alt: event.image_alt.presence || "" %>
    </div>
  <% else %>
    <div class="card-image-placeholder card-image-placeholder--poster" role="img"
         aria-label="<%= event.party? ? "Party-Veranstaltung" : event.auftritt? ? "Auftritt" : "Sonstige Veranstaltung" %>">
      <%= event.party? ? "🎉" : event.auftritt? ? "🎵" : "📅" %>
    </div>
  <% end %>
  <div class="card-body">
    <h3><%= event.title %></h3>
    <div class="card-meta">
      <span><span aria-hidden="true">📅</span> <%= l event.starts_at, format: :long %></span>
      <% if event.location.present? %>
        <span><span aria-hidden="true">📍</span> <%= event.location %></span>
      <% end %>
    </div>
    <% if event.description.present? %>
      <p><%= truncate(event.description, length: 120) %></p>
    <% end %>
  </div>
  <div class="card-footer">
    <%= event_type_badge(event.event_type) %>
    <%= link_to event_path(event), class: "btn btn-outline btn-sm", aria: { label: "Details zu #{event.title}" } do %>Details<% end %>
    <% if event.ticket_url.present? %>
      <a href="<%= event.ticket_url %>" target="_blank" rel="noopener" class="btn btn-primary btn-sm">Tickets</a>
    <% end %>
  </div>
</article>
