<% content_for :title, @event.title %>

<div class="container">
  <div class="event-detail">

    <% if @event.image.attached? %>
      <div class="event-detail__poster">
        <%= image_tag @event.image, alt: @event.title %>
      </div>
    <% end %>

    <div class="event-detail__content">
      <%= event_type_badge(@event.event_type) %>
      <h1><%= @event.title %></h1>

      <div class="event-detail__meta">
        <div class="event-detail__meta-item">
          <span class="event-detail__meta-label">Datum</span>
          <span><%= l @event.starts_at, format: :long %></span>
        </div>
        <% if @event.location.present? %>
          <div class="event-detail__meta-item">
            <span class="event-detail__meta-label">Ort</span>
            <span><%= @event.location %></span>
          </div>
        <% end %>
      </div>

      <% if @event.description.present? %>
        <div class="event-detail__description">
          <%= simple_format(@event.description) %>
        </div>
      <% end %>

      <% if @event.ticket_url.present? %>
        <a href="<%= @event.ticket_url %>" target="_blank" rel="noopener" class="btn btn-primary">Tickets kaufen</a>
      <% end %>

      <p class="mt-3"><%= link_to "← Alle Veranstaltungen", events_path %></p>
    </div>

  </div>
</div>
