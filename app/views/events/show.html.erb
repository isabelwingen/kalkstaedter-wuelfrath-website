<% content_for :title, @event.title %>

<div class="container">
  <article>
    <div class="article-header">
      <%= event_type_badge(@event.event_type) %>
      <h1><%= @event.title %></h1>
      <div class="article-meta">
        <span>📅 <%= l @event.starts_at, format: :long %></span>
        <% if @event.location.present? %>
          <span>📍 <%= @event.location %></span>
        <% end %>
      </div>
    </div>

    <% if @event.image.attached? %>
      <div class="article-image">
        <%= image_tag @event.image, alt: @event.title %>
      </div>
    <% end %>

    <% if @event.description.present? %>
      <div class="article-content">
        <%= simple_format(@event.description) %>
      </div>
    <% end %>

    <% if @event.ticket_url.present? %>
      <p class="mt-3">
        <a href="<%= @event.ticket_url %>" target="_blank" rel="noopener" class="btn btn-primary">🎟 Tickets kaufen</a>
      </p>
    <% end %>

    <p class="mt-3">
      <%= link_to "← Alle Veranstaltungen", events_path %>
    </p>
  </article>
</div>
