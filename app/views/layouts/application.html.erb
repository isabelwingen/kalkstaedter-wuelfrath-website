<!DOCTYPE html>
<html lang="de">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} – Kalkstädter Wülfrath" : "Kalkstädter Wülfrath e.V." %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta charset="utf-8">
    <meta name="description" content="<%= content_for?(:description) ? yield(:description) : "Kalkstädter Wülfrath e.V. – Das Querflötenorchester aus Wülfrath. Konzerte, Veranstaltungen und Musikschule." %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/images/e._logo_444.jpg" type="image/jpeg">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script defer src="https://analytics.verwaltung-kalkstaedter.de/script.js" data-website-id="1a964c6e-9e92-445c-9aab-6980c95d75e3"></script>
  </head>

  <body>
    <a href="#main-content" class="skip-link">Zum Inhalt springen</a>
    <div class="top-accent" aria-hidden="true"></div>
    <nav class="site-nav">
      <div class="container">
        <%= link_to root_path, class: "nav-brand" do %>
          <img src="/images/logo-mark.svg" alt="" class="nav-brand-logo" aria-hidden="true">
          <span class="nav-brand-text">
            Kalkstädter Wülfrath e.V.
            <span>Querflötenorchester</span>
          </span>
        <% end %>
        <button class="nav-toggle" aria-label="Menü öffnen" aria-expanded="false" aria-controls="main-nav"
                onclick="var m=document.getElementById('main-nav');m.classList.toggle('open');this.setAttribute('aria-expanded',m.classList.contains('open'))"><span aria-hidden="true">☰</span></button>
        <ul class="nav-links" id="main-nav">
          <li><%= link_to "Veranstaltungen", events_path,      class: nav_link_class(events_path),      aria: { current: aria_current_page(events_path) } %></li>
          <li><%= link_to "Berichte",        posts_path,       class: nav_link_class(posts_path),       aria: { current: aria_current_page(posts_path) } %></li>
          <li><%= link_to "Mitmachen",       mitmachen_path,   class: nav_link_class(mitmachen_path),   aria: { current: aria_current_page(mitmachen_path) } %></li>
          <li><%= link_to "Über uns",        ueber_uns_path,   class: nav_link_class(ueber_uns_path),   aria: { current: aria_current_page(ueber_uns_path) } %></li>
          <li><%= link_to "Presse & Links",  press_links_path, class: nav_link_class(press_links_path), aria: { current: aria_current_page(press_links_path) } %></li>
        </ul>
      </div>
    </nav>

    <% if notice.present? %>
      <div class="container"><p class="flash notice mt-2" role="alert" aria-live="polite"><%= notice %></p></div>
    <% end %>
    <% if alert.present? %>
      <div class="container"><p class="flash alert mt-2" role="alert" aria-live="assertive"><%= alert %></p></div>
    <% end %>

    <main id="main-content">
      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-col">
            <h2>Kalkstädter Wülfrath e.V.</h2>
            <address>
              Tiegenhöfer Str. 4<br>
              42489 Wülfrath<br>
              <a href="mailto:info@kalkstaedter-wuelfrath.de">info@kalkstaedter-wuelfrath.de</a>
            </address>
          </div>
          <div class="footer-col">
            <h2>Entdecken</h2>
            <ul>
              <li><%= link_to "Veranstaltungen", events_path %></li>
              <li><%= link_to "Berichte", posts_path %></li>
              <li><%= link_to "Mitmachen", mitmachen_path %></li>
              <li><%= link_to "Über uns", ueber_uns_path %></li>
              <li><%= link_to "Presse & Links", press_links_path %></li>
            </ul>
          </div>
          <div class="footer-col">
            <h2>Folgt uns</h2>
            <ul>
              <li><a href="https://www.instagram.com/kalkstaedterwuelfrath/" target="_blank" rel="noopener">Instagram</a></li>
              <li><a href="https://www.facebook.com/kalkstaedter/" target="_blank" rel="noopener">Facebook</a></li>
              <li><a href="https://whatsapp.com/channel/0029Vb6bL0yGk1FufD0T5c2S" target="_blank" rel="noopener">WhatsApp-Kanal</a></li>
            </ul>
          </div>
        </div>
        <img src="/images/logo-full.svg" alt="Kalkstädter Wülfrath e.V." class="footer-logo">
        <div class="footer-bottom">
          &copy; <%= Date.current.year %> Kalkstädter Wülfrath e.V. &middot;
          <%= link_to "Impressum", impressum_path %> &middot;
          <%= link_to "Datenschutz", datenschutz_path %> &middot;
          <%= link_to "Barrierefreiheit", barrierefreiheit_path %>
        </div>
      </div>
    </footer>
  </body>
</html>
