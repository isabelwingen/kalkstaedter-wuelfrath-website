<% content_for :title, "Neues Passwort setzen" %>

<div class="container">
  <div class="admin-login-wrapper">
    <h1>Neues Passwort setzen</h1>

    <% if flash[:alert].present? %>
      <p class="flash alert"><%= flash[:alert] %></p>
    <% end %>

    <%= form_with url: password_path(params[:token]), method: :put, class: "admin-form" do |f| %>
      <div class="form-group">
        <%= f.label :password, "Neues Passwort" %>
        <%= f.password_field :password, required: true,
              autocomplete: "new-password", maxlength: 72 %>
      </div>
      <div class="form-group">
        <%= f.label :password_confirmation, "Passwort wiederholen" %>
        <%= f.password_field :password_confirmation, required: true,
              autocomplete: "new-password", maxlength: 72 %>
      </div>
      <div class="form-actions">
        <%= f.submit "Passwort speichern", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
