<article class="card">
  <% if post.image.attached? %>
    <div class="card-image">
      <%= image_tag post.image, alt: post.image_alt.presence || "" %>
    </div>
  <% else %>
    <div class="card-image-placeholder" role="img" aria-label="Bericht ohne Titelbild">📝</div>
  <% end %>
  <div class="card-body">
    <h3><%= post.title %></h3>
    <div class="card-meta">
      <% if post.published_at.present? %>
        <span><span aria-hidden="true">📅</span> <%= l post.published_at, format: :long %></span>
      <% end %>
    </div>
    <p><%= truncate(post.content, length: 150) %></p>
  </div>
  <div class="card-footer">
    <%= link_to post_path(post), class: "btn btn-outline btn-sm", aria: { label: "#{post.title} lesen" } do %>Weiterlesen<% end %>
  </div>
</article>
