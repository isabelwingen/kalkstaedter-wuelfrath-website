<% if event.errors.any? %>
  <div class="error-summary">
    <h4><%= pluralize(event.errors.count, "Fehler") %> verhindert das Speichern:</h4>
    <ul>
      <% event.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: [:admin, event], class: "admin-form" do |f| %>
  <div class="form-group">
    <%= f.label :title, "Titel" %>
    <%= f.text_field :title %>
  </div>

  <div class="form-group">
    <%= f.label :event_type, "Typ" %>
    <%= f.select :event_type, [["Auftritt", "auftritt"], ["Party", "party"], ["Sonstiges", "sonstiges"]] %>
  </div>

  <div class="form-group">
    <%= f.label :starts_at, "Datum & Uhrzeit" %>
    <%= f.datetime_local_field :starts_at %>
  </div>

  <div class="form-group">
    <%= f.label :location, "Ort" %>
    <%= f.text_field :location %>
  </div>

  <div class="form-group">
    <%= f.label :ticket_url, "Ticket-Link (optional)" %>
    <%= f.url_field :ticket_url, placeholder: "https://..." %>
    <p class="form-hint">Link zum Ticketkauf, falls Eintritt zu zahlen ist.</p>
  </div>

  <div class="form-group">
    <%= f.label :description, "Beschreibung" %>
    <%= f.text_area :description %>
  </div>

  <div class="form-group">
    <%= f.label :image, "Bild (Plakat / Foto)" %>
    <% if event.image.attached? %>
      <div class="image-preview">
        <%= image_tag event.image, alt: event.image_alt.presence || "" %>
      </div>
    <% end %>
    <%= f.file_field :image, accept: "image/*" %>
  </div>

  <div class="form-group">
    <%= f.label :image_alt, "Alternativtext (Bild)" %>
    <%= f.text_field :image_alt, placeholder: "z. B. „Buntes Plakat mit Ballons zur Mallorca-Party am 6. Juni"" %>
    <p class="form-hint">Beschreibt das Bild für Screenreader. Leer lassen, wenn das Bild rein dekorativ ist und der Titel bereits alles erklärt.</p>
  </div>

  <div class="form-group">
    <div class="form-check">
      <%= f.check_box :published %>
      <%= f.label :published, "Veröffentlicht (auf der Website sichtbar)" %>
    </div>
  </div>

  <div class="form-actions">
    <%= f.submit "Speichern", class: "btn btn-primary" %>
    <%= link_to "Abbrechen", admin_events_path, class: "btn btn-outline" %>
  </div>
<% end %>
