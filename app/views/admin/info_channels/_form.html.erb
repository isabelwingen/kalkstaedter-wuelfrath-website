<% if info_channel.errors.any? %>
  <div class="error-summary">
    <h4><%= pluralize(info_channel.errors.count, "Fehler") %>:</h4>
    <ul><% info_channel.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
  </div>
<% end %>

<%= form_with model: [:admin, info_channel], class: "admin-form" do |f| %>
  <div class="form-group">
    <%= f.label :name, "Name" %>
    <%= f.text_field :name, placeholder: "z.B. Instagram Kalkstädter" %>
  </div>
  <div class="form-group">
    <%= f.label :platform, "Plattform" %>
    <%= f.select :platform, [["Instagram", "instagram"], ["Facebook", "facebook"],
          ["WhatsApp", "whatsapp"], ["YouTube", "youtube"], ["Sonstiges", "sonstiges"]] %>
  </div>
  <div class="form-group">
    <%= f.label :url, "URL" %>
    <%= f.url_field :url, placeholder: "https://..." %>
  </div>
  <div class="form-actions">
    <%= f.submit "Speichern", class: "btn btn-primary" %>
    <%= link_to "Abbrechen", admin_info_channels_path, class: "btn btn-outline" %>
  </div>
<% end %>
