<% if press_link.errors.any? %>
  <div class="error-summary">
    <h4><%= pluralize(press_link.errors.count, "Fehler") %>:</h4>
    <ul><% press_link.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
  </div>
<% end %>

<%= form_with model: [:admin, press_link], class: "admin-form" do |f| %>
  <div class="form-group">
    <%= f.label :title, "Titel des Artikels" %>
    <%= f.text_field :title %>
  </div>
  <div class="form-group">
    <%= f.label :url, "Link zum Artikel" %>
    <%= f.url_field :url, placeholder: "https://..." %>
  </div>
  <div class="form-group">
    <%= f.label :publication, "Zeitung / Quelle" %>
    <%= f.text_field :publication, placeholder: "z.B. Wülfrather Zeitung" %>
  </div>
  <div class="form-group">
    <%= f.label :published_on, "Erscheinungsdatum" %>
    <%= f.date_field :published_on %>
  </div>
  <div class="form-actions">
    <%= f.submit "Speichern", class: "btn btn-primary" %>
    <%= link_to "Abbrechen", admin_press_links_path, class: "btn btn-outline" %>
  </div>
<% end %>
