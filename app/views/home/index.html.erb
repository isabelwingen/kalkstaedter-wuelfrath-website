<div class="home-hero">
  <%= image_tag "orchester.png", alt: "Das Orchester der Kalkstädter Wülfrath e.V. bei einem Auftritt", class: "home-hero__img" %>
  <div class="container">
    <div class="home-hero__content">
      <p class="home-hero__eyebrow">Musik aus der Kalkstadt · seit 1954</p>
      <h1>Das Querflötenorchester aus Wülfrath</h1>
      <p>Querflöten, Percussion und ein Repertoire, das Spaß macht – bei Konzerten, Partys und allem dazwischen.</p>
    </div>
  </div>
</div>

<% if @upcoming_events.any? %>
<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>Kommende Veranstaltungen</h2>
      <%= link_to "Alle ansehen", events_path %>
    </div>
    <div class="event-ledger">
      <% @upcoming_events.each do |event| %>
        <article class="event-ledger__item">
          <p class="event-ledger__date">
            <time datetime="<%= event.starts_at.iso8601 %>">
              <span class="event-ledger__day"><%= event.starts_at.strftime("%-d.") %></span>
              <span class="event-ledger__month"><%= l(event.starts_at, format: "%b %Y") %></span>
              <span class="event-ledger__weekday"><%= l(event.starts_at, format: "%A, %-H Uhr") %></span>
            </time>
          </p>
          <div class="event-ledger__info">
            <p class="event-ledger__type event-ledger__type--<%= event.event_type %>">
              <span class="event-ledger__notehead" aria-hidden="true"></span><%= event_type_label(event.event_type) %>
            </p>
            <h3><%= link_to event.title, event_path(event) %></h3>
            <% if event.location.present? %>
              <p class="event-ledger__location"><%= event.location %></p>
            <% end %>
          </div>
          <p class="event-ledger__action">
            <% if event.ticket_url.present? %>
              <a href="<%= event.ticket_url %>" target="_blank" rel="noopener" class="btn btn-primary">Tickets</a>
            <% else %>
              <span class="event-ledger__free">Eintritt frei</span>
            <% end %>
          </p>
        </article>
      <% end %>
    </div>
  </div>
</section>
<% end %>

<% if @recent_posts.any? %>
<%= render "shared/ornament" %>

<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>Berichte</h2>
      <%= link_to "Alle Berichte", posts_path %>
    </div>

    <% featured = @recent_posts.first %>
    <article class="featured-article">
      <div class="featured-article__image">
        <% if featured.image.attached? %>
          <%= image_tag featured.image, alt: featured.image_alt.presence || "" %>
        <% else %>
          <div class="featured-article__image-placeholder" role="img" aria-label="Bericht"></div>
        <% end %>
      </div>
      <div class="featured-article__content">
        <h3><%= link_to featured.title, post_path(featured) %></h3>
        <% if featured.published_at.present? %>
          <p class="featured-article__date"><%= l featured.published_at, format: :long %></p>
        <% end %>
        <p class="featured-article__excerpt"><%= truncate(featured.content, length: 200) %></p>
        <%= link_to "Weiterlesen", post_path(featured), class: "btn btn-outline btn-sm" %>
      </div>
    </article>

    <% if @recent_posts.size > 1 %>
      <ul class="article-list">
        <% @recent_posts.drop(1).each do |post| %>
          <li class="article-list__item">
            <%= link_to post.title, post_path(post) %>
            <% if post.published_at.present? %>
              <span class="article-list__date"><%= l post.published_at, format: :long %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</section>
<% end %>

<%= render "shared/ornament" %>

<section class="home-join">
  <div class="container">
    <div class="section-header">
      <h2>Mitmachen</h2>
    </div>
    <p class="home-join__lead">Wir suchen keine Perfektion. Wir suchen Menschen mit Freude an Musik, die donnerstags Zeit haben.</p>
    <div class="home-join__cols">
      <div class="home-join__col">
        <h3>Du spielst schon?</h3>
        <p>
          Querflöte oder Percussion: Schreib uns kurz, dann laden wir dich zur Schnupperprobe
          an einem Donnerstagabend ein. Unverbindlich, ohne Vorspielen – die Noten legen
          wir dir hin.
        </p>
        <div class="home-join__actions">
          <a href="mailto:info@kalkstaedter-wuelfrath.de?subject=Schnupperprobe" class="btn btn-primary">Schreib uns</a>
          <%= link_to "Mehr erfahren", mitmachen_path, class: "btn btn-outline" %>
        </div>
      </div>
      <div class="home-join__col">
        <h3>Du fängst neu an?</h3>
        <p>
          Unsere Musikschule bringt dir Querflöte oder Percussion bei – egal, ob du acht
          bist oder achtundsechzig. Unterricht bei uns im Verein, und sobald es passt,
          geht es mit ins Orchester.
        </p>
        <%= link_to "Zur Musikschule", musikschule_path, class: "btn btn-primary" %>
      </div>
    </div>
    <p class="home-join__social">
      Neuigkeiten und Einblicke gibt's auf
      <a href="https://www.instagram.com/kalkstaedterwuelfrath/" target="_blank" rel="noopener">Instagram</a>,
      <a href="https://www.facebook.com/kalkstaedter/" target="_blank" rel="noopener">Facebook</a>
      und im <a href="https://whatsapp.com/channel/0029Vb6bL0yGk1FufD0T5c2S" target="_blank" rel="noopener">WhatsApp-Kanal</a>.
    </p>
  </div>
</section>
