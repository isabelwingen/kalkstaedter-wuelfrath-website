<div class="hero">
  <h1>Willkommen bei den Kalkstädtern</h1>
  <p>Querflötenorchester aus Wülfrath – Musik für Menschen jeden Alters</p>
  <%= link_to "Jetzt mitmachen!", mitmachen_path, class: "btn btn-primary" %>
</div>

<div class="orchester-foto">
  <%= image_tag "orchester.png", alt: "Das Orchester der Kalkstädter Wülfrath e.V.", class: "orchester-foto__img" %>
  <p class="orchester-foto__caption">Das Orchester der Kalkstädter Wülfrath e.V.</p>
</div>

<% if @upcoming_events.any? %>
<div class="section">
  <div class="container">
    <div class="section-header">
      <h2>Nächste Veranstaltungen</h2>
      <%= link_to "Alle Veranstaltungen →", events_path %>
    </div>
    <div class="card-grid">
      <%= render @upcoming_events %>
    </div>
  </div>
</div>
<% end %>

<% if @recent_posts.any? %>
<div class="section">
  <div class="container">
    <div class="section-header">
      <h2>Aktuelle Berichte</h2>
      <%= link_to "Alle Berichte →", posts_path %>
    </div>
    <div class="card-grid">
      <%= render @recent_posts %>
    </div>
  </div>
</div>
<% end %>

<div class="section">
  <div class="container">
    <div class="section-header">
      <h2>Bleib auf dem Laufenden</h2>
    </div>
    <div class="card-grid">
      <div class="card">
        <div class="card-image-placeholder">📸</div>
        <div class="card-body">
          <h3>Instagram</h3>
          <p>Fotos und Kurzvideos von Proben, Auftritten und Vereinsleben.</p>
        </div>
        <div class="card-footer">
          <a href="https://www.instagram.com/kalkstaedterwuelfrath/" target="_blank" rel="noopener" class="btn btn-outline">@kalkstaedterwuelfrath</a>
        </div>
      </div>
      <div class="card">
        <div class="card-image-placeholder">👥</div>
        <div class="card-body">
          <h3>Facebook</h3>
          <p>Neuigkeiten und Ankündigungen auf unserer Facebook-Seite.</p>
        </div>
        <div class="card-footer">
          <a href="https://www.facebook.com/kalkstaedter/" target="_blank" rel="noopener" class="btn btn-outline">facebook.com/kalkstaedter</a>
        </div>
      </div>
      <div class="card">
        <div class="card-image-placeholder">💬</div>
        <div class="card-body">
          <h3>WhatsApp-Kanal</h3>
          <p>Direkt auf dein Handy – keine Nachrichten mehr verpassen.</p>
        </div>
        <div class="card-footer">
          <a href="https://whatsapp.com/channel/0029Vb6bL0yGk1FufD0T5c2S" target="_blank" rel="noopener" class="btn btn-outline">Kanal abonnieren</a>
        </div>
      </div>
    </div>
  </div>
</div>
