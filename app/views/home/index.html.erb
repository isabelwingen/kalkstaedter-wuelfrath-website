<div class="home-hero">
  <%= image_tag "orchester.png", alt: "Das Orchester der Kalkstädter Wülfrath e.V.", class: "home-hero__img" %>
  <div class="home-hero__overlay">
    <div class="container">
      <div class="home-hero__content">
        <p class="home-hero__eyebrow">Kalkstädter Wülfrath e.V. · Querflötenorchester</p>
        <h1>Das Querflötenorchester aus Wülfrath.</h1>
        <p>Querflöten, Percussion und ein Repertoire, das Spaß macht – bei Konzerten, Partys und allem dazwischen.</p>
      </div>
    </div>
  </div>
</div>

<% if @upcoming_events.any? %>
<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>Nächste Veranstaltungen</h2>
      <%= link_to "Alle Veranstaltungen →", events_path %>
    </div>
    <ul class="event-agenda">
      <% @upcoming_events.each do |event| %>
        <li class="event-agenda__item">
          <time class="event-agenda__date" datetime="<%= event.starts_at.to_date %>">
            <span class="event-agenda__day"><%= event.starts_at.strftime("%-d") %></span>
            <span class="event-agenda__month"><%= l(event.starts_at, format: "%b") %></span>
          </time>
          <div class="event-agenda__info">
            <h3><%= link_to event.title, event_path(event) %></h3>
            <% if event.location.present? %>
              <span class="event-agenda__location"><%= event.location %></span>
            <% end %>
          </div>
          <div class="event-agenda__aside">
            <%= event_type_badge(event.event_type) %>
            <% if event.ticket_url.present? %>
              <a href="<%= event.ticket_url %>" target="_blank" rel="noopener" class="btn btn-sm btn-outline">Tickets</a>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  </div>
</section>
<% end %>

<% if @recent_posts.any? %>
<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>Aktuelles</h2>
      <%= link_to "Alle Berichte →", posts_path %>
    </div>
    <div class="card-grid">
      <%= render @recent_posts %>
    </div>
  </div>
</section>
<% end %>

<section class="home-cta">
  <div class="container">
    <h2>Lust, dabei zu sein?</h2>
    <p>Wir freuen uns über neue Gesichter – ob erfahrene Musikerinnen und Musiker oder Anfänger, die Querflöte oder Schlagwerk entdecken möchten.</p>
    <div class="home-cta__actions">
      <%= link_to "Mitmachen", mitmachen_path, class: "btn btn-light" %>
      <%= link_to "Zur Musikschule", musikschule_path, class: "btn btn-light" %>
    </div>
  </div>
</section>

<div class="home-social">
  <div class="container">
    <p class="home-social__label">Folgt uns auf</p>
    <ul class="social-row">
      <li><a href="https://www.instagram.com/kalkstaedterwuelfrath/" target="_blank" rel="noopener">Instagram · @kalkstaedterwuelfrath</a></li>
      <li><a href="https://www.facebook.com/kalkstaedter/" target="_blank" rel="noopener">Facebook · Kalkstädter Wülfrath</a></li>
      <li><a href="https://whatsapp.com/channel/0029Vb6bL0yGk1FufD0T5c2S" target="_blank" rel="noopener">WhatsApp-Kanal abonnieren</a></li>
    </ul>
  </div>
</div>
